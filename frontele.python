class Queue:

    def __init__(self):
        self.queue = []

    def enqueue(self, value):
        self.queue.append(value)

    def front(self):
        if len(self.queue) == 0:
            print("Queue is empty")
        else:
            print(self.queue[0])


q = Queue()

q.enqueue(10)
q.enqueue(20)
q.enqueue(30)

q.front()
